; Central Feed Services (CFS) [SFI-ES4.2.4]
; All package restore must go through the internal Azure Artifacts feed, which
; proxies public npm through its upstream. Do NOT point `registry` at
; https://registry.npmjs.org/ - that endpoint is forbidden by the CFSClean policy.
; This is the same feed already used by test/.npmrc, samples/.npmrc and the bulk
; of package-lock.json.
registry=https://pkgs.dev.azure.com/mseng/PipelineTools/_packaging/PipelineTools_PublicPackages/npm/registry/
always-auth=true
